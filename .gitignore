# ── Rust ─────────────────────────────────────────────
target/
# Cargo.lock IS committed: soroban-env-host declares `ed25519-dalek = ">=2.0.0"`,
# so an unpinned resolve picks 3.0.0, whose CryptoRng bound the host's test PRNG
# does not satisfy, and every crate's test build fails to compile. The lockfile
# holds it at 2.x.

# ── Stellar / Soroban ────────────────────────────────
.soroban/
.stellar/

# ── Node / Next.js ───────────────────────────────────
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo

# ── Environment files (never commit secrets) ─────────
.env
.env.local
.env.*.local
.env.production
backend/.env

# ── Logs & Coverage ──────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
coverage/
    

