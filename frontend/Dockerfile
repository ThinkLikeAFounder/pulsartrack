# Frontend Dockerfile - Multi-stage build for Next.js
# Stage 1: Dependencies
FROM node:22-alpine AS deps
WORKDIR /app

# Install dependencies based on the preferred package manager
COPY package.json package-lock.json* ./
RUN npm ci

# Stage 2: Builder
FROM node:22-alpine AS builder
WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy source code
COPY . .

# Set environment variables for build
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Build-time ARGs for NEXT_PUBLIC_* variables.
# Next.js inlines these into the client bundle at `next build` time, so they
# must be present in the builder stage — runtime `environment:` in compose is
# too late.  Pass them via `build.args` in docker-compose.yml (or --build-arg
# on the CLI) sourced from the same .env file used at runtime.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WS_URL
ARG NEXT_PUBLIC_NETWORK
ARG NEXT_PUBLIC_HORIZON_URL
ARG NEXT_PUBLIC_SOROBAN_RPC_URL
ARG NEXT_PUBLIC_SIMULATION_ACCOUNT
ARG NEXT_PUBLIC_SENTRY_DSN

# Contract IDs
ARG NEXT_PUBLIC_CONTRACT_CAMPAIGN_ORCHESTRATOR
ARG NEXT_PUBLIC_CONTRACT_CAMPAIGN_LIFECYCLE
ARG NEXT_PUBLIC_CONTRACT_ESCROW_VAULT
ARG NEXT_PUBLIC_CONTRACT_FRAUD_PREVENTION
ARG NEXT_PUBLIC_CONTRACT_PAYMENT_PROCESSOR
ARG NEXT_PUBLIC_CONTRACT_AUCTION_ENGINE
ARG NEXT_PUBLIC_CONTRACT_PUBLISHER_NETWORK
ARG NEXT_PUBLIC_CONTRACT_PUBLISHER_VERIFICATION
ARG NEXT_PUBLIC_CONTRACT_GOVERNANCE_DAO
ARG NEXT_PUBLIC_CONTRACT_GOVERNANCE_TOKEN
ARG NEXT_PUBLIC_CONTRACT_IDENTITY_REGISTRY
ARG NEXT_PUBLIC_CONTRACT_ORACLE_INTEGRATION
ARG NEXT_PUBLIC_CONTRACT_TARGETING_ENGINE
ARG NEXT_PUBLIC_CONTRACT_ANALYTICS_AGGREGATOR
ARG NEXT_PUBLIC_CONTRACT_PRIVACY_LAYER
ARG NEXT_PUBLIC_CONTRACT_SUBSCRIPTION_MANAGER
ARG NEXT_PUBLIC_CONTRACT_TOKEN_BRIDGE

# Export ARGs as ENV so Next.js picks them up during `next build`
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_NETWORK=$NEXT_PUBLIC_NETWORK
ENV NEXT_PUBLIC_HORIZON_URL=$NEXT_PUBLIC_HORIZON_URL
ENV NEXT_PUBLIC_SOROBAN_RPC_URL=$NEXT_PUBLIC_SOROBAN_RPC_URL
ENV NEXT_PUBLIC_SIMULATION_ACCOUNT=$NEXT_PUBLIC_SIMULATION_ACCOUNT
ENV NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN
ENV NEXT_PUBLIC_CONTRACT_CAMPAIGN_ORCHESTRATOR=$NEXT_PUBLIC_CONTRACT_CAMPAIGN_ORCHESTRATOR
ENV NEXT_PUBLIC_CONTRACT_CAMPAIGN_LIFECYCLE=$NEXT_PUBLIC_CONTRACT_CAMPAIGN_LIFECYCLE
ENV NEXT_PUBLIC_CONTRACT_ESCROW_VAULT=$NEXT_PUBLIC_CONTRACT_ESCROW_VAULT
ENV NEXT_PUBLIC_CONTRACT_FRAUD_PREVENTION=$NEXT_PUBLIC_CONTRACT_FRAUD_PREVENTION
ENV NEXT_PUBLIC_CONTRACT_PAYMENT_PROCESSOR=$NEXT_PUBLIC_CONTRACT_PAYMENT_PROCESSOR
ENV NEXT_PUBLIC_CONTRACT_AUCTION_ENGINE=$NEXT_PUBLIC_CONTRACT_AUCTION_ENGINE
ENV NEXT_PUBLIC_CONTRACT_PUBLISHER_NETWORK=$NEXT_PUBLIC_CONTRACT_PUBLISHER_NETWORK
ENV NEXT_PUBLIC_CONTRACT_PUBLISHER_VERIFICATION=$NEXT_PUBLIC_CONTRACT_PUBLISHER_VERIFICATION
ENV NEXT_PUBLIC_CONTRACT_GOVERNANCE_DAO=$NEXT_PUBLIC_CONTRACT_GOVERNANCE_DAO
ENV NEXT_PUBLIC_CONTRACT_GOVERNANCE_TOKEN=$NEXT_PUBLIC_CONTRACT_GOVERNANCE_TOKEN
ENV NEXT_PUBLIC_CONTRACT_IDENTITY_REGISTRY=$NEXT_PUBLIC_CONTRACT_IDENTITY_REGISTRY
ENV NEXT_PUBLIC_CONTRACT_ORACLE_INTEGRATION=$NEXT_PUBLIC_CONTRACT_ORACLE_INTEGRATION
ENV NEXT_PUBLIC_CONTRACT_TARGETING_ENGINE=$NEXT_PUBLIC_CONTRACT_TARGETING_ENGINE
ENV NEXT_PUBLIC_CONTRACT_ANALYTICS_AGGREGATOR=$NEXT_PUBLIC_CONTRACT_ANALYTICS_AGGREGATOR
ENV NEXT_PUBLIC_CONTRACT_PRIVACY_LAYER=$NEXT_PUBLIC_CONTRACT_PRIVACY_LAYER
ENV NEXT_PUBLIC_CONTRACT_SUBSCRIPTION_MANAGER=$NEXT_PUBLIC_CONTRACT_SUBSCRIPTION_MANAGER
ENV NEXT_PUBLIC_CONTRACT_TOKEN_BRIDGE=$NEXT_PUBLIC_CONTRACT_TOKEN_BRIDGE

# Build Next.js application
RUN npm run build

# Stage 3: Runner (Production)
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create non-root user for security
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy necessary files from builder
COPY --from=builder /app/public ./public
COPY --from=builder /app/package.json ./package.json

# Copy built application
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Start the application
CMD ["node", "server.js"]
