# Stellar network: "testnet" or "mainnet"
NEXT_PUBLIC_NETWORK=testnet

# WebSocket URL for real-time updates (backend WebSocket endpoint)
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Contract IDs — obtain from the deployment record in deployments/
# All are required; the app throws on startup if any are missing.
NEXT_PUBLIC_CONTRACT_AD_REGISTRY=
NEXT_PUBLIC_CONTRACT_ANALYTICS_AGGREGATOR=
NEXT_PUBLIC_CONTRACT_AUCTION_ENGINE=
NEXT_PUBLIC_CONTRACT_CAMPAIGN_ORCHESTRATOR=
NEXT_PUBLIC_CONTRACT_DISPUTE_RESOLUTION=
NEXT_PUBLIC_CONTRACT_ESCROW_VAULT=
NEXT_PUBLIC_CONTRACT_FRAUD_PREVENTION=
NEXT_PUBLIC_CONTRACT_GOVERNANCE_DAO=
NEXT_PUBLIC_CONTRACT_GOVERNANCE_TOKEN=
NEXT_PUBLIC_CONTRACT_IDENTITY_REGISTRY=
NEXT_PUBLIC_CONTRACT_PAYMENT_PROCESSOR=
NEXT_PUBLIC_CONTRACT_PRIVACY_LAYER=
NEXT_PUBLIC_CONTRACT_PUBLISHER_REPUTATION=
NEXT_PUBLIC_CONTRACT_PUBLISHER_VERIFICATION=
NEXT_PUBLIC_CONTRACT_REVENUE_SETTLEMENT=
NEXT_PUBLIC_CONTRACT_REWARDS_DISTRIBUTOR=
NEXT_PUBLIC_CONTRACT_SUBSCRIPTION_MANAGER=
NEXT_PUBLIC_CONTRACT_TARGETING_ENGINE=

# Optional: Stellar account used for read-only contract simulations.
# Falls back to a dev-only default if not set.
# NEXT_PUBLIC_SIMULATION_ACCOUNT=

# Optional: Sentry DSN for error tracking.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=

# Optional: Backend API URL (used in CSP connect-src for cross-origin API calls).
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: CSP mode. Set to "enforce" to activate the Content-Security-Policy
# header instead of the default report-only mode. Must be set at build time
# for Docker builds (add to build.args in docker-compose.yml).
# CSP_MODE=enforce

# Optional: CSP violation report endpoint. Defaults to "/api/csp-report".
# Set to a Sentry CSP endpoint URL for centralized reporting.
# NEXT_PUBLIC_CSP_REPORT_URI=/api/csp-report
