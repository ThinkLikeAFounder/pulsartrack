# Docker Compose Environment Variables
# Copy this file to .env for backend/docker setup.
# For frontend environment setup, see frontend/.env.example and copy it to frontend/.env.local.

# Database
POSTGRES_USER=pulsartrack
POSTGRES_PASSWORD=   # Generate with: openssl rand -base64 32
POSTGRES_DB=pulsartrack
REDIS_PASSWORD=      # Generate with: openssl rand -base64 32
JWT_SECRET=          # Generate with: openssl rand -hex 32

# Error Tracking & Observability (Sentry)
SENTRY_DSN=          # Backend DSN (e.g., https://xxx@o0.ingest.sentry.io/0)
NEXT_PUBLIC_SENTRY_DSN= # Frontend Client DSN (e.g., https://xxx@o0.ingest.sentry.io/0)

